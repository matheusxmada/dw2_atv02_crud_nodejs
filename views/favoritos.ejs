<!-- Página Carros Favoritos -->
<!DOCTYPE html>
<html lang="pt-BR">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Carros Favoritos | RALLYHUB</title>

    <link rel="stylesheet" href="/css/style.css">

</head>

<body>

    <!-- Incluindo a navbar -->
    <%- include("partials/navbar") %>


    <main class="favoritos-main">


        <!-- Hero -->

        <section class="favoritos-hero">

            <div class="favoritos-hero-content">

                <p class="hero-subtitle">
                    RALLYHUB / MINHA COLEÇÃO
                </p>

                <h1>
                    CARROS<br>
                    <span>FAVORITOS</span>
                </h1>

                <p class="hero-text">
                    Crie sua própria coleção de carros marcantes da
                    história do Rally, adicionando informações sobre
                    seus modelos favoritos.
                </p>

                <a href="#favoritos" class="hero-button">
                    GERENCIAR FAVORITOS
                </a>

            </div>

        </section>


        <!-- Área de favoritos -->

        <section id="favoritos" class="favoritos-section">

            <div class="favoritos-container">


                <!-- Cabeçalho da seção -->

                <div class="favoritos-title">

                    <p class="favoritos-subtitle">
                        MINHA COLEÇÃO
                    </p>

                    <h2>
                        SEUS CARROS<br>
                        <span>FAVORITOS</span>
                    </h2>

                    <div class="title-line"></div>

                    <p class="favoritos-description">
                        Adicione, edite ou remova carros da sua coleção
                        pessoal do RALLYHUB.
                    </p>

                </div>


                <!-- Formulário -->

                <div class="favoritos-form-wrapper">

                    <div class="favoritos-form-header">

                        <span class="form-number">
                            01
                        </span>

                        <div>

                            <p>
                                NOVO FAVORITO
                            </p>

                            <h3>
                                ADICIONAR CARRO
                            </h3>

                        </div>

                    </div>


                    <form
                        action="/favoritos/cadastrar"
                        method="POST"
                        class="favoritos-form"
                    >


                        <div class="form-group">

                            <label for="nomeCarro">
                                Nome do carro
                            </label>

                            <input
                                type="text"
                                id="nomeCarro"
                                name="nomeCarro"
                                placeholder="Ex.: Audi Quattro"
                                required
                            >

                        </div>


                        <div class="form-group">

                            <label for="marca">
                                Marca
                            </label>

                            <input
                                type="text"
                                id="marca"
                                name="marca"
                                placeholder="Ex.: Audi"
                                required
                            >

                        </div>


                        <div class="form-group">

                            <label for="modelo">
                                Modelo
                            </label>

                            <input
                                type="text"
                                id="modelo"
                                name="modelo"
                                placeholder="Ex.: Quattro"
                                required
                            >

                        </div>


                        <div class="form-group">

                            <label for="ano">
                                Ano
                            </label>

                            <input
                                type="number"
                                id="ano"
                                name="ano"
                                placeholder="Ex.: 1980"
                                min="1900"
                                max="2100"
                                required
                            >

                        </div>


                        <div class="form-group">

                            <label for="potenciaHP">
                                Potência
                            </label>

                            <div class="hp-input">

                                <input
                                    type="number"
                                    id="potenciaHP"
                                    name="potenciaHP"
                                    placeholder="Ex.: 300"
                                    min="1"
                                    required
                                >

                                <span>HP</span>

                            </div>

                        </div>


                        <button
                            type="submit"
                            class="favoritos-submit"
                        >
                            ADICIONAR AOS FAVORITOS
                        </button>


                    </form>

                </div>


                <!-- Lista -->

                <div class="favoritos-list-wrapper">


                    <div class="favoritos-list-header">

                        <div>

                            <p class="favoritos-subtitle">
                                COLEÇÃO
                            </p>

                            <h2>
                                CARROS SALVOS
                            </h2>

                        </div>

                        <span class="form-number">
                            02
                        </span>

                    </div>


                    <div class="favoritos-table-container">

                        <table class="favoritos-table">

                            <thead>

                                <tr>

                                    <th>ID</th>

                                    <th>Carro</th>

                                    <th>Marca</th>

                                    <th>Modelo</th>

                                    <th>Ano</th>

                                    <th>Potência</th>

                                    <th>Ações</th>

                                </tr>

                            </thead>


                            <tbody>

                                <% if (favoritos.length > 0) { %>

                                    <% favoritos.forEach((favorito) => { %>

                                        <tr>

                                            <td class="favorite-id">
                                                #<%= favorito.id %>
                                            </td>

                                            <td class="favorite-name">
                                                <%= favorito.nomeCarro %>
                                            </td>

                                            <td>
                                                <%= favorito.marca %>
                                            </td>

                                            <td>
                                                <%= favorito.modelo %>
                                            </td>

                                            <td>
                                                <%= favorito.ano %>
                                            </td>

                                            <td class="favorite-hp">
                                                <%= favorito.potenciaHP %> HP
                                            </td>

                                            <td class="favorite-actions">

                                                <a
                                                    href="/favoritos/editar/<%= favorito.id %>"
                                                    class="favorite-edit"
                                                >
                                                    EDITAR
                                                </a>

                                                <a
                                                    href="/favoritos/excluir/<%= favorito.id %>"
                                                    class="favorite-delete"
                                                    onclick="return confirm('Deseja realmente excluir este carro?')"
                                                >
                                                    EXCLUIR
                                                </a>

                                            </td>

                                        </tr>

                                    <% }); %>

                                <% } else { %>

                                    <tr>

                                        <td
                                            colspan="7"
                                            class="empty-favorites"
                                        >
                                            NENHUM CARRO FAVORITO CADASTRADO.
                                        </td>

                                    </tr>

                                <% } %>

                            </tbody>

                        </table>

                    </div>

                </div>


            </div>

        </section>


        <!-- Seção final -->

        <section class="favoritos-objective">

            <div class="favoritos-objective-content">

                <div class="favoritos-objective-text">

                    <p class="favoritos-subtitle">
                        SUA COLEÇÃO
                    </p>

                    <h2>
                        HISTÓRIA.<br>
                        VELOCIDADE.<br>
                        <span>PAIXÃO.</span>
                    </h2>

                    <p>
                        Reúna os carros que mais marcaram a história
                        do Rally e mantenha sua própria coleção dentro
                        do RALLYHUB.
                    </p>

                    <a href="/cars" class="hero-button">
                        EXPLORAR CARROS
                    </a>

                </div>


                <div class="favoritos-objective-image">


                </div>

            </div>

        </section>


    </main>


    <!-- Incluindo o footer -->
    <%- include("partials/footer") %>


</body>

</html>