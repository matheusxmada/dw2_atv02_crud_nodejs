<!-- Página de favoritos -->
<%- include("partials/header.ejs") %>
<%- include("partials/navbar.ejs") %>

<div class="container">

    <div class="card">

        <div class="card-header">
            <h1>Carros favoritos</h1>
        </div>

        <div class="card-body">

            <form action="/favoritos/cadastrar" method="POST">

                <div class="mb-3">
                    <label>Nome do carro</label>

                    <input
                        type="text"
                        name="nomeCarro"
                        class="form-control"
                        required
                    >
                </div>


                <div class="mb-3">
                    <label>Marca</label>

                    <input
                        type="text"
                        name="marca"
                        class="form-control"
                        required
                    >
                </div>


                <div class="mb-3">
                    <label>Modelo</label>

                    <input
                        type="text"
                        name="modelo"
                        class="form-control"
                        required
                    >
                </div>


                <div class="mb-3">
                    <label>Ano</label>

                    <input
                        type="number"
                        name="ano"
                        class="form-control"
                        required
                    >
                </div>


                <div class="mb-3">
                    <label>Potência (HP)</label>

                    <input
                        type="number"
                        name="potenciaHP"
                        class="form-control"
                        required
                    >
                </div>


                <button
                    type="submit"
                    class="btn btn-primary"
                >
                    Adicionar aos favoritos
                </button>

            </form>

        </div>

    </div>


    <br>


    <div class="card">

        <div class="card-header">
            <h2>Lista de carros favoritos</h2>
        </div>

        <div class="card-body">

            <table class="table table-striped">

                <thead>

                    <tr>
                        <th>ID</th>
                        <th>Nome</th>
                        <th>Marca</th>
                        <th>Modelo</th>
                        <th>Ano</th>
                        <th>Potência</th>
                        <th>Ações</th>
                    </tr>

                </thead>

                <tbody>

                    <% favoritos.forEach((favorito) => { %>

                        <tr>

                            <td>
                                <%= favorito.id %>
                            </td>

                            <td>
                                <%= favorito.nomeCarro %>
                            </td>

                            <td>
                                <%= favorito.marca %>
                            </td>

                            <td>
                                <%= favorito.modelo %>
                            </td>

                            <td>
                                <%= favorito.ano %>
                            </td>

                            <td>
                                <%= favorito.potenciaHP %> HP
                            </td>

                            <td>

                                <a
                                    href="/favoritos/editar/<%= favorito.id %>"
                                    class="btn btn-warning"
                                >
                                    Editar
                                </a>

                                <a
                                    href="/favoritos/excluir/<%= favorito.id %>"
                                    class="btn btn-danger"
                                    onclick="return confirm('Deseja realmente excluir este carro?')"
                                >
                                    Excluir
                                </a>

                            </td>

                        </tr>

                    <% }); %>

                </tbody>

            </table>

        </div>

    </div>

</div>