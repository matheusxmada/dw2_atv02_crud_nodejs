<%- include("partials/header.ejs") %>
<%- include("partials/navbar.ejs") %>

<div class="container">

    <div class="card">

        <div class="card-header">
            <h1>Editar Carro Favorito</h1>
        </div>

        <div class="card-body">

            <form
                action="/favoritos/editar/<%= favorito.id %>"
                method="POST">

                <div class="mb-3">

                    <label for="nomeCarro">
                        Nome do carro
                    </label>

                    <input
                        type="text"
                        id="nomeCarro"
                        name="nomeCarro"
                        class="form-control"
                        value="<%= favorito.nomeCarro %>"
                        required>

                </div>


                <div class="mb-3">

                    <label for="marca">
                        Marca
                    </label>

                    <input
                        type="text"
                        id="marca"
                        name="marca"
                        class="form-control"
                        value="<%= favorito.marca %>"
                        required>

                </div>


                <div class="mb-3">

                    <label for="categoria">
                        Categoria
                    </label>

                    <input
                        type="text"
                        id="categoria"
                        name="categoria"
                        class="form-control"
                        value="<%= favorito.categoria %>">

                </div>


                <div class="mb-3">

                    <label for="ano">
                        Ano
                    </label>

                    <input
                        type="number"
                        id="ano"
                        name="ano"
                        class="form-control"
                        value="<%= favorito.ano %>">

                </div>


                <div class="mb-3">

                    <label for="descricao">
                        Descrição
                    </label>

                    <textarea
                        id="descricao"
                        name="descricao"
                        class="form-control"><%= favorito.descricao %></textarea>

                </div>


                <button
                    type="submit"
                    class="btn btn-success">
                    Salvar alterações
                </button>

                <a
                    href="/favoritos"
                    class="btn btn-secondary">
                    Cancelar
                </a>

            </form>

        </div>

    </div>

</div>